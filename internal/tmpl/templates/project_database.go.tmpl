// Package database opens the shared connection pool and applies migrations. Each module
// owns its own schema; modules never query each other's tables.
package database

import (
	"context"
	"io/fs"
	"log/slog"
	"time"

	_ "{{.DriverImport}}" // database/sql driver

	"{{.Kit}}/pg"
)

// Open connects to PostgreSQL with sane pool settings.
func Open(ctx context.Context, url string, maxConns int, log *slog.Logger) (*pg.DB, error) {
	db, err := pg.Open("{{.DriverName}}", url, pg.Options{Logger: log})
	if err != nil {
		return nil, err
	}
	sqlDB := db.SQLDB()
	sqlDB.SetMaxOpenConns(maxConns)
	sqlDB.SetMaxIdleConns(maxConns) // keep warm connections; idle ones are recycled below
	sqlDB.SetConnMaxIdleTime(5 * time.Minute)
	sqlDB.SetConnMaxLifetime(time.Hour)
	if err := db.Connect(ctx); err != nil {
		return nil, err
	}
	return db, nil
}

// Migrate applies pending SQL migrations from fsys.
func Migrate(ctx context.Context, db *pg.DB, fsys fs.FS, log *slog.Logger) error {
	_, err := pg.NewMigrator(db, fsys, pg.MigratorOptions{Logger: log}).Up(ctx)
	return err
}
